{
  "name": "root-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "imports": {
    "#convex/_generated/api": "./convex/_generated/api.js",
    "#convex/_generated/dataModel": "./convex/_generated/dataModel.d.ts",
    "#convex/_generated/server": "./convex/_generated/server.js",
    "#convex/*": "./convex/*.ts"
  },
  "scripts": {
    "convex:test": "vitest run --config vitest.convex.config.ts",
    "convex:typecheck": "tsc --noEmit -p convex/tsconfig.json",
    "check": "bun run lint && bun run typecheck && bun run test && bun run convex:typecheck && bun run convex:test",
    "typecheck": "bun run --filter austi typecheck && bun run --filter austi-landing check && bun run --filter trading typecheck && bun run --filter austi-desktop typecheck && bun run --filter portfolio check && bun run --filter @workspace/web-foundation typecheck",
    "test": "bun run --filter austi test && bun run --filter trading test && bun run --filter austi-desktop test",
    "format": "oxfmt --write .",
    "portfolio:dev": "pitchfork start portfolio",
    "portfolio:build": "bun run --elide-lines=0 --filter portfolio build",
    "portfolio:preview": "pitchfork start portfolio-preview",
    "austi-landing:dev": "pitchfork start austi-landing",
    "austi-landing:build": "bun run --elide-lines=0 --filter austi-landing build",
    "austi-landing:preview": "pitchfork start austi-landing-preview",
    "trading:dev": "pitchfork start trading",
    "trading:build": "bun run --elide-lines=0 --filter trading build",
    "trading:preview": "pitchfork start trading-preview",
    "trading:test": "bun run --elide-lines=0 --filter trading test",
    "trading:convex": "pitchfork start trading-convex",
    "austi-desktop:dev": "pitchfork start austi-desktop",
    "austi-desktop:build": "bun run --filter austi-desktop tauri build",
    "austi-desktop:test": "bun run --filter austi-desktop test",
    "ui:add": "bun run --cwd packages/ui ui:add",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:typecheck": "oxlint --type-aware --type-check",
    "austi:dev": "pitchfork start austi",
    "austi:build": "bun run --filter austi build",
    "austi:preview": "pitchfork start austi-preview",
    "austi:convex": "pitchfork start austi-convex"
  },
  "dependencies": {
    "@tanstack/ai": "^0.53.0",
    "@tanstack/ai-vercel-gateway": "^0.2.8",
    "convex": "^1.37.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "convex-test": "0.0.54",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "oxlint-tsgolint": "^0.22.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "packageManager": "bun@1.3.7"
}
