{
  "name": "austi-desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "check:format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "dev": "vite --port 1421",
    "build": "vite build",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "lint": "oxlint src vite.config.ts",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets --all-features --locked -- -D warnings",
    "test": "vitest run src",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "typecheck": "bunx tsc --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/ai": "^0.42.0",
    "@tanstack/ai-react": "^0.18.1",
    "@tanstack/react-router": "1.169.2",
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-dialog": "2.6.0",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "@workspace/ui": "workspace:*",
    "lucide-react": "^1.14.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.167.34",
    "@tauri-apps/cli": "2.11.2",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
