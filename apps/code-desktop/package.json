{
  "name": "code-desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420",
    "build": "vite build",
    "test": "vitest run src",
    "test:unit": "vitest run src",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "playwright install chromium && playwright test",
    "test:fixtures": "cargo test --manifest-path src-tauri/Cargo.toml local_sessions",
    "test:session-harness": "cargo test --manifest-path src-tauri/Cargo.toml session_harness",
    "test:verification-fixtures": "cargo test --manifest-path src-tauri/Cargo.toml verification_fixtures",
    "test:process-fixtures": "cargo test --manifest-path src-tauri/Cargo.toml process_fixtures",
    "test:lifecycle-fixtures": "cargo test --manifest-path src-tauri/Cargo.toml lifecycle_fixtures",
    "test:browser-fixtures": "cargo test --manifest-path src-tauri/Cargo.toml browser_fixtures",
    "test:product-fixtures": "cargo test --manifest-path src-tauri/Cargo.toml product_fixtures",
    "test:product-e2e": "bun run test:product-fixtures && playwright test",
    "test:runtime-readiness": "cargo test --manifest-path src-tauri/Cargo.toml runtime_readiness && cargo run --quiet --manifest-path src-tauri/Cargo.toml --example verify_codex_runtime && bun run scripts/verify-runtime.ts",
    "package:mvp": "bun run tauri build && bun run scripts/verify-package.ts",
    "package:verify": "bun run scripts/verify-package.ts",
    "typecheck": "bunx tsc --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-router": "1.169.2",
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-dialog": "2.6.0",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@workspace/code-agent-contracts": "workspace:*",
    "@workspace/code-workbench": "workspace:*",
    "@workspace/ui": "workspace:*",
    "lucide-react": "^1.14.0",
    "posthog-js": "^1.368.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@tanstack/router-plugin": "^1.167.34",
    "@tauri-apps/cli": "2.11.2",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
