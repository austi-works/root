---
import './SectionIntro.css';

interface Props {
  id: string;
  title: string;
  muted?: string;
  lede?: string;
}

const { id, title, muted, lede } = Astro.props;
---

<header class="section-intro page-wrap">
  <h2 class="heading" id={id} data-reveal>
    {title}
    {muted && <span>{muted}</span>}
  </h2>
  {lede && <p class="lede" data-reveal>{lede}</p>}
</header>
