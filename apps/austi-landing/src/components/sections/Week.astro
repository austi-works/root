---
import { week } from '../../lib/landing-content';
import SectionIntro from '../SectionIntro.astro';
import './Week.css';
---

<section class="week dark-field" id="week" aria-labelledby="week-title">
  <SectionIntro
    id="week-title"
    title="What a launch could feel like."
    muted="Without the Sunday-night panic."
    lede="The workflow we are building towards, not a promise about how long your campaign will take."
  />

  <div class="week-list page-wrap" data-week>
    <span class="week-rule" aria-hidden="true"><i data-week-line></i></span>
    <ol>
    {week.map((entry) => (
      <li class="week-item" data-week-item>
        <span class="week-dot" aria-hidden="true"></span>
        <div class="week-day" data-reveal>
          <strong>{entry.day}</strong>
        </div>
        <div class="week-copy" data-reveal style="--reveal-delay: 100ms">
          <h3>{entry.title}</h3>
          <p>{entry.copy}</p>
        </div>
      </li>
    ))}
    </ol>
  </div>
</section>
