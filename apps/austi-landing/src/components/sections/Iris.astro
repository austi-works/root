---
import './Iris.css';

const first = 'More content.';
const second = 'Still unmistakably you.';
---

<section class="iris" data-iris aria-labelledby="iris-title">
  <div class="iris-stage" data-stage>
    <div class="iris-layer">
      <h2 class="iris-title" id="iris-title" data-iris-title>{first}<span>{second}</span></h2>
    </div>
    <div class="iris-layer iris-layer--paper" data-iris-paper aria-hidden="true">
      <p class="iris-title" data-iris-title>{first}<span>{second}</span></p>
    </div>
  </div>
</section>
