---
import { heroContent } from '../lib/landing-content';
import { HeroFlowSvg } from './HeroFlowSvg';
import './DeskScene.css';

const { scene } = heroContent;
---

<figure class="desk-scene" data-desk-scene>
  <div class="desk-stage">
    <picture>
      <source
        srcset="/images/hero-empty-desk-836.webp 836w, /images/hero-empty-desk-1672.webp 1672w"
        sizes="(min-width: 1920px) 1760px, (min-width: 1024px) 100vw, 176vw"
        type="image/webp"
      />
      <img
        src="/images/hero-empty-desk.png"
        alt={scene.alt}
        width="1672"
        height="941"
        fetchpriority="high"
      />
    </picture>
    <HeroFlowSvg />
  </div>
  <figcaption class="desk-caption">
    <span>{scene.caption}</span>
    <button class="desk-motion-toggle" type="button" data-desk-toggle data-play-label={scene.play} data-pause-label={scene.pause} aria-pressed="false" hidden>
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 4v8M10 4v8" /></svg>
      <span>{scene.pause}</span>
    </button>
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-desk-scene]').forEach((scene) => {
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const toggle = scene.querySelector<HTMLButtonElement>('[data-desk-toggle]');
    const svg = scene.querySelector<SVGSVGElement>('[data-hero-flow]');
    let ready = false;
    let visible = false;
    let paused = false;
    let started = false;
    let firstFrame = 0;
    let secondFrame = 0;

    const update = () => {
      const playing = ready && visible && !paused && !motion.matches && !document.hidden;
      scene.dataset.playing = String(playing);
      if (svg) {
        if (playing) {
          if (!started) {
            // SMIL remains dormant until after the first paint and until visible.
            svg.querySelectorAll<SVGAnimationElement>('[data-flow-motion]').forEach((animation) => animation.beginElement());
            started = true;
          }
          svg.unpauseAnimations();
        } else {
          svg.pauseAnimations();
        }
      }
      if (toggle) {
        toggle.hidden = !ready || motion.matches;
        toggle.setAttribute('aria-pressed', String(paused));
        toggle.querySelector('path')?.setAttribute('d', paused ? 'm6 4 6 4-6 4Z' : 'M6 4v8M10 4v8');
        const label = toggle.querySelector('span');
        if (label) label.textContent = (paused ? toggle.dataset.playLabel : toggle.dataset.pauseLabel) ?? '';
      }
    };

    const togglePaused = () => { paused = !paused; update(); };
    toggle?.addEventListener('click', togglePaused);
    motion.addEventListener('change', update);
    document.addEventListener('visibilitychange', update);

    const observer = new IntersectionObserver(([entry]) => {
      visible = entry?.isIntersecting ?? false;
      update();
    }, { threshold: 0.1 });
    observer.observe(scene.closest('.hero') ?? scene);
    update();

    // Two frames leave the original photograph visible for the first paint.
    firstFrame = requestAnimationFrame(() => {
      secondFrame = requestAnimationFrame(() => { ready = true; update(); });
    });

    document.addEventListener('astro:before-swap', () => {
      observer.disconnect();
      cancelAnimationFrame(firstFrame);
      cancelAnimationFrame(secondFrame);
      toggle?.removeEventListener('click', togglePaused);
      motion.removeEventListener('change', update);
      document.removeEventListener('visibilitychange', update);
    }, { once: true });
  });
</script>
