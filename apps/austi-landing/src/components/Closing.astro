---
import './Closing.css';

interface Props {
  pilotUrl: string;
}

const { pilotUrl } = Astro.props;
---

<section class="closing paper-field" id="pilot" aria-labelledby="closing-title">
  <h2 id="closing-title">Make room for your next big idea.</h2>
  <a class="closing-button" href={pilotUrl}>Get early access<svg viewBox="0 0 18 18" aria-hidden="true"><path d="M3.5 9h11M10 4.5 14.5 9 10 13.5"></path></svg></a>
</section>
