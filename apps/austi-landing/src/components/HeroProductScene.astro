---
import './HeroProductScene.css';
---

<figure class="hero-product-scene">
  <div class="product-viewport" role="img" aria-label="Illustration: you give Austi your website, it drafts an ad, a social post, an email and an SEO snippet, and you approve each one">
    <div class="product-canvas" aria-hidden="true">
      <div class="scene-core"><img src="/austi-logo.svg" width="28" height="30" alt="" /></div>
    </div>
  </div>
  <figcaption class="product-caption">
    <span>Illustrative workflow</span>
    <button class="product-motion-toggle" type="button" hidden>Pause animation</button>
  </figcaption>
</figure>
