---
import './SiteHeader.css';

interface Props {
  pilotUrl: string;
}

const { pilotUrl } = Astro.props;
const onHomePage = Astro.url.pathname === '/';
const links = [
  { id: 'learn', name: 'Learn' },
  { id: 'plan', name: 'Plan' },
  { id: 'create', name: 'Create' },
  { id: 'review', name: 'Review' },
  { id: 'faq', name: 'FAQ' },
];
---

<div class="site-header-shell" data-site-header>
  <header class="site-header">
    <a class="header-brand" href={onHomePage ? '#top' : '/'} aria-label="Austi home">
      <img src="/austi-logo.svg" alt="" width="18" height="20" />
      <span>Austi</span>
    </a>
    <nav aria-label="Main navigation">
      <i class="nav-pill" data-nav-pill aria-hidden="true"></i>
      {links.map((link) => (
        <a href={onHomePage ? `#${link.id}` : `/#${link.id}`} data-nav-link={link.id}>{link.name}</a>
      ))}
    </nav>
    <a class="header-cta" href={pilotUrl} data-magnetic>
      <span>Get early access</span>
      <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M3.5 9h11M10 4.5 14.5 9 10 13.5"></path></svg>
    </a>
    <div class="header-progress" data-scroll-progress aria-hidden="true"></div>
  </header>
</div>
