---
import DeskScene from './DeskScene.astro';
import IntegrationMarquee from './IntegrationMarquee.astro';
import { LiveCounter } from './LiveCounter';
import ProofPill from './ProofPill.astro';
import { heroContent } from '../lib/landing-content';
import './Hero.css';

interface Props {
  pilotUrl: string;
}

const { pilotUrl } = Astro.props;
---

<section class="hero dark-field" id="top" aria-label={`${heroContent.product} introduction`}>
  <div class="hero-main">
    <div class="hero-intro">
      <ProofPill {...heroContent.proof} />
      <h1 class="hero-heading">{heroContent.heading}</h1>
      <p class="hero-description">{heroContent.paragraph} <span>{heroContent.paragraphMuted}</span></p>
      <a class="hero-download" href={pilotUrl}>
        <img
          class="hero-download-hdr"
          data-hero-download-hdr
          src="/images/hero-cta-superwhite.avif"
          alt=""
          width="64"
          height="64"
          fetchpriority="high"
          decoding="sync"
          aria-hidden="true"
        />
        <span>{heroContent.cta}</span>
        <svg viewBox="0 0 18 18" aria-hidden="true">
          <path d="M3.5 9h11M10 4.5 14.5 9 10 13.5"></path>
        </svg>
      </a>
      <ul class="hero-trust">
        {heroContent.trust.map((item) => (
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              {item.icon === 'lock'
                ? <><rect x="5" y="10" width="14" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3" /></>
                : <><path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6Z" /><path d="m8.5 12 2.5 2.5 4.5-5" /></>}
            </svg>
            <span><strong>{item.title}</strong><span>{item.detail}</span></span>
          </li>
        ))}
      </ul>
    </div>
    <DeskScene />
  </div>
  <div class="hero-strip">
    <IntegrationMarquee integrations={heroContent.integrations} label={heroContent.integrationsLabel} />
    <div class="hero-counter">
      <LiveCounter client:load endpoint={heroContent.metric.endpoint} label={heroContent.metric.label} />
    </div>
  </div>
</section>

<script>
  const hdrImage = document.querySelector<HTMLImageElement>('[data-hero-download-hdr]');

  if (hdrImage) {
    const revealHdr = () => hdrImage.classList.add('is-loaded');

    if (hdrImage.complete) {
      if (hdrImage.naturalWidth > 0) revealHdr();
    } else {
      hdrImage.addEventListener('load', revealHdr, { once: true });
    }
  }
</script>
