---
import ChapterRail from '../components/ChapterRail.astro';
import Faq from '../components/Faq.astro';
import Access from '../components/sections/Access.astro';
import Audience from '../components/sections/Audience.astro';
import Closing from '../components/sections/Closing.astro';
import Create from '../components/sections/Create.astro';
import Hero from '../components/sections/Hero.astro';
import Iris from '../components/sections/Iris.astro';
import Learn from '../components/sections/Learn.astro';
import Limits from '../components/sections/Limits.astro';
import Plan from '../components/sections/Plan.astro';
import Planet from '../components/sections/Planet.astro';
import Review from '../components/sections/Review.astro';
import Statement from '../components/sections/Statement.astro';
import Voice from '../components/sections/Voice.astro';
import Week from '../components/sections/Week.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Layout from '../layouts/Layout.astro';
import { faqItems } from '../lib/landing-content';

const title = 'Austi | AI Marketing for Ads, Social, Email & Search';
const description =
  'Meet Austi, an AI marketing workspace in development for founders and small teams. Plan ads, social posts, emails and search content around your brand.';
const pilotUrl = 'mailto:hello@austi.works?subject=Austi%20marketing%20early%20access';
const siteUrl = 'https://austi.works/';
const socialImageUrl = `${siteUrl}og-austi.png`;
const logoUrl = `${siteUrl}austi-logo.svg`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      name: 'Austi',
      url: siteUrl,
      description,
      inLanguage: 'en',
      publisher: { '@id': `${siteUrl}#organization` },
    },
    {
      '@type': 'WebPage',
      '@id': `${siteUrl}#webpage`,
      url: siteUrl,
      name: title,
      description,
      isPartOf: { '@id': `${siteUrl}#website` },
      mainEntity: { '@id': `${siteUrl}#organization` },
      primaryImageOfPage: { '@id': `${siteUrl}#primaryimage` },
      hasPart: { '@id': `${siteUrl}#faq` },
      inLanguage: 'en',
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#organization`,
      name: 'Austi',
      url: siteUrl,
      description,
      logo: logoUrl,
      image: { '@id': `${siteUrl}#primaryimage` },
    },
    {
      '@type': 'ImageObject',
      '@id': `${siteUrl}#primaryimage`,
      url: socialImageUrl,
      contentUrl: socialImageUrl,
      width: 1200,
      height: 630,
      caption: 'Austi — your AI marketing workspace for ads, social, email and search.',
    },
    {
      '@type': 'FAQPage',
      '@id': `${siteUrl}#faq`,
      url: `${siteUrl}#faq`,
      isPartOf: { '@id': `${siteUrl}#webpage` },
      inLanguage: 'en',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
  ],
};
---

<Layout {title} {description} {structuredData}>
  <SiteHeader {pilotUrl} />
  <ChapterRail />
  <main id="main-content">
    <Hero {pilotUrl} />
    <Statement />
    <Learn />
    <Plan />
    <Create />
    <Iris />
    <div class="paper-curtain">
      <div class="paper-run paper-field" data-paper-run>
        <Voice />
        <Review />
      </div>
      <Planet />
    </div>
    <Week />
    <Limits />
    <Audience />
    <Access {pilotUrl} />
    <Faq />
    <Closing {pilotUrl} />
  </main>
  <SiteFooter />
</Layout>

<script>
  import '../scripts/landing-interactions';
  import '../scripts/landing-motion';
</script>
