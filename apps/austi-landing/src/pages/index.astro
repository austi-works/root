---
import Closing from '../components/Closing.astro';
import Faq from '../components/Faq.astro';
import Hero from '../components/Hero.astro';
import Mechanism from '../components/Mechanism.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Trust from '../components/Trust.astro';
import Layout from '../layouts/Layout.astro';
import { faqItems } from '../lib/landing-content';

const title = 'Austi | AI Marketing for Ads, Social, Email & Search';
const description =
  'Meet Austi, an AI marketing workspace in development for founders and small teams. Plan ads, social posts, emails and search content around your brand.';
const pilotUrl = 'mailto:hello@austi.works?subject=Austi%20marketing%20early%20access';
const siteUrl = 'https://austi.works/';
const socialImageUrl = `${siteUrl}og-austi.png`;
const logoUrl = `${siteUrl}austi-logo.svg`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      name: 'Austi',
      url: siteUrl,
      description,
      inLanguage: 'en',
      publisher: { '@id': `${siteUrl}#organization` },
    },
    {
      '@type': 'WebPage',
      '@id': `${siteUrl}#webpage`,
      url: siteUrl,
      name: title,
      description,
      isPartOf: { '@id': `${siteUrl}#website` },
      mainEntity: { '@id': `${siteUrl}#organization` },
      primaryImageOfPage: { '@id': `${siteUrl}#primaryimage` },
      hasPart: { '@id': `${siteUrl}#faq` },
      inLanguage: 'en',
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#organization`,
      name: 'Austi',
      url: siteUrl,
      description,
      logo: logoUrl,
      image: { '@id': `${siteUrl}#primaryimage` },
    },
    {
      '@type': 'ImageObject',
      '@id': `${siteUrl}#primaryimage`,
      url: socialImageUrl,
      contentUrl: socialImageUrl,
      width: 1731,
      height: 909,
      caption: 'Austi — your AI marketing workspace for ads, social, email and search.',
    },
    {
      '@type': 'FAQPage',
      '@id': `${siteUrl}#faq`,
      url: `${siteUrl}#faq`,
      isPartOf: { '@id': `${siteUrl}#webpage` },
      inLanguage: 'en',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
  ],
};
---

<Layout {title} {description} {structuredData}>
  <SiteHeader {pilotUrl} />
  <main id="main-content">
    <Hero {pilotUrl} />
    <Mechanism />
    <Trust />
    <Faq />
    <Closing {pilotUrl} />
  </main>
  <SiteFooter />
</Layout>
